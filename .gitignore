# in data/README.md is tracked.
*.csv
*.xlsx
*.xls
*.numbers
*.jsonl
*.json
*.txt
!requirements.txt
*.parquet
*.pkl
*.rds
*.RData
*.rda
outputs/
data/*
!data/README.md

# Office documents (reports may quote donor comments)
*.docx
*.pptx

# Secrets
.env

# R / Python / OS clutter
.Rhistory
.Rproj.user/
__pycache__/
.ipynb_checkpoints/
.DS_Store

# Plots generated by the scripts
*.png
